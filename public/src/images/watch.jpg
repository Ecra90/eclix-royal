,{"startIndex":1800,"length":10,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1810,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1811,"length":17,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294966512,"raisedBackground":4294966512,"additiveBackground":566864709,"textPrimary":4281740298,"textSecondary":4285424442,"invertedBackground":4287000344,"overlayBackground":3426102282},"darkThemeColorPalette":{"baseBackground":4280030722,"raisedBackground":4281740298,"additiveBackground":734636869,"textPrimary":4294636768,"textSecondary":4292727468,"invertedBackground":4293119100,"overlayBackground":3426102282},"colorSampledDescriptionBodyText":{"content":"Welcome to an unforgettable luxury home tour experience! Get ready to immerse yourself in over an hour of breathtaking interior design and explore the most stunning features of high-end living. This extended video showcases multiple beautifully crafted model homes, each offering a unique blend of elegance, comfort, and modern sophistication.\n\nIn this inspiring tour, you’ll experience:\n\n✨ Gourmet Kitchens Built for Entertaining\nTour chef-worthy kitchens featuring premium appliances, custom cabinetry, and expansive islands that bring style and function together beautifully.\n\n🛏️ Luxurious Primary Suites\nStep into relaxing bedroom retreats with spa-style bathrooms, elegant finishes, and walk-in closets designed for both beauty and convenience.\n\n🛋️ Bright, Open Living Spaces\nExplore open-concept layouts that highlight natural light, seamless indoor-outdoor flow, and thoughtfully arranged furnishings that elevate every moment.\n\n🌿 Outdoor Living at Its Finest\nBe inspired by beautifully designed patios, cozy lounges, and landscaped backyards—perfect for relaxing or entertaining in style.\n\n💡 Sophisticated Interior Details\nFrom stylish lighting and high-end flooring to curated color palettes and custom design touches, every corner is full of visual delight.\n\n📱 Smart Home Integration\nSee how modern technology is effortlessly woven into these spaces, offering enhanced comfort, security, and luxury living.\n\nWhether you’re dreaming, designing, or just love exploring beautiful spaces, this long-form luxury tour is packed with ideas and inspiration.\n\nSUBSCRIBE for more incredible house tours and Decor Ideas.\n\nCheck out my channel for more eye candy!\n   / @alexluxdecor  \n\n\nCheck out my playlist!\n   • 2025 House Tours  \n\n#houses #luxuryhomes #decorideas #housedesign #hometour #home #modelhome #luxuryrealestate","commandRuns":[{"startIndex":1738,"length":7,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIQBENzXBBgVIhMIsZWA0q-olAMVWl5BAh2_FSjBygEEvD7i4Q==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/houses","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUKCgZob3VzZXMYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CIQBENzXBBgVIhMIsZWA0q-olAMVWl5BAh2_FSjB"}},{"startIndex":1746,"length":12,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIMBENzXBBgWIhMIsZWA0q-olAMVWl5BAh2_FSjBygEEvD7i4Q==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/luxuryhomes","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUPCgtsdXh1cnlob21lcxgB"}}},"loggingDirectives":{"trackingParams":"CIMBENzXBBgWIhMIsZWA0q-olAMVWl5BAh2_FSjB"}},{"startIndex":1759,"length":11,"onTap":{"innertubeCommand":{"clickTrackingParams":"CIIBENzXBBgXIhMIsZWA0q-olAMVWl5BAh2_FSjBygEEvD7i4Q==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/decorideas","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUOCgpkZWNvcmlkZWFzGAE%3D"}}
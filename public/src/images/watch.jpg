dly hacks, and much more. I believe that everyone deserves to live in a beautiful home, regardless of their budget or lifestyle, and Im here to help you achieve that goal.\n\nSo whether you are looking for inspiration for your next home renovation project, or simply love admiring beautiful homes, AlexLuxDecor has something for everyone. \n"},"callToAction":{"simpleText":"VISIT CHANNEL"},"dismiss":{"simpleText":"CANCEL"},"endpoint":{"clickTrackingParams":"CAgQ-N4BGAAiEwiQioDSr6iUAxUZoHwGHTwYGkAyDGl2LWVuZHNjcmVlbkjmo5yI3aPn4DPKAQS8PuLh","commandMetadata":{"webCommandMetadata":{"url":"/channel/UCfniuqShL9VEEWgI9NiIfYQ","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCfniuqShL9VEEWgI9NiIfYQ"}},"hovercardButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"SUBSCRIBE"}]},"subscribed":false,"enabled":true,"type":"FREE","channelId":"UCfniuqShL9VEEWgI9NiIfYQ","showPreferences":false,"subscribedButtonText":{"runs":[{"text":"SUBSCRIBED"}]},"unsubscribedButtonText":{"runs":[{"text":"SUBSCRIBE"}]},"trackingParams":"CAkQmysiEwiQioDSr6iUAxUZoHwGHTwYGkAyDGl2LWVuZHNjcmVlbg==","unsubscribeButtonText":{"runs":[{"text":"UNSUBSCRIBE"}]},"serviceEndpoints":[{"clickTrackingParams":"CAkQmysiEwiQioDSr6iUAxUZoHwGHTwYGkAyDGl2LWVuZHNjcmVlbsoBBLw-4uE=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/subscribe"}},"subscribeEndpoint":{"channelIds":["UCfniuqShL9VEEWgI9NiIfYQ"],"params":"EgIIBBgA"}},{"clickTrackingParams":"CAkQmysiEwiQioDSr6iUAxUZoHwGHTwYGkDKAQS8PuLh","commandMetadata":{"webCommandMetadata":{"sendPost":true}},"signalServiceEndpoint":{"signal":"CLIENT_SIGNAL","actions":[{"clickTrackingParams":"CAkQmysiEwiQioDSr6iUAxUZoHwGHTwYGkDKAQS8PuLh","openPopupAction":{"popup":{"confirmDialogRenderer":{"trackingParams":"CAoQxjgiEwiQioDSr6iUAxUZoHwGHTwYGkA=","dialogMessages":[{"runs":[{"text":"Unsubscribe from "},{"text":"AlexLuxDecor"},{"text":"?"}]}],"confirmButton":{"